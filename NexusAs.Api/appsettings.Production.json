{
  "ConnectionStrings": {
    "NexusAsConnection": "#{DB_CONNECTION_STRING}#"
  },
  "JwtSettings": {
    "SecretKey": "#{JWT_SECRET_KEY}#",
    "Issuer": "#{JWT_ISSUER}#",
    "Audience": "#{JWT_AUDIENCE}#",
    "ExpirationHours": 8
  },
  "AllowedOrigins": {
    "Frontend": "#{FRONTEND_URL}#"
  },
  "PaginationOptions": {
    "DefaultPageSize": 10,
    "MaxPageSize": 50
  },
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
